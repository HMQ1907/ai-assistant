{
  "name": "ai-trading-assistant",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "npm run typecheck && set NUXT_IGNORE_LOCK=1&& nuxt build",
    "lint": "nuxt typecheck",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:live": "cross-env RUN_LIVE_API_TESTS=true vitest run tests/live",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxt/ui": "^3.1.3",
    "@supabase/supabase-js": "^2.107.0",
    "nuxt": "^3.17.5",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.10"
  }
}
