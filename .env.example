EVOLINK_API_KEY=
EVOLINK_MODEL=claude-opus-4.8
EVOLINK_BASE_URL=https://api.evolink.ai/v1/chat/completions
AI_TIMEOUT_MS=90000

# Vốn tham chiếu (~$200 micro). Risk thật lấy equity từ MT5 khi có.
ACCOUNT_SIZE_USD=200
MAX_LOSS_PERCENT_PER_TRADE=10
MAX_DAILY_LOSS_PERCENT=5

MARKET_DATA_PROVIDER=mt5
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://api.twelvedata.com
MT5_BRIDGE_URL=http://127.0.0.1:8765
MT5_SYMBOL=XAUUSDm
MT5_EURUSD_SYMBOL=EURUSDm
MAX_QUOTE_AGE_SECONDS=180
MARKET_DATA_DEBUG=false

NEWS_PROVIDER=gnews
NEWS_API_KEY=
NEWS_BASE_URL=https://gnews.io
NEWS_MAX_AGE_HOURS=48

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Scanner thức 24/7; engine tự chặn theo trend, volatility, spread và lịch tin.
TRADE_SCANNER_ENABLED=false
TRADE_SCANNER_TIMEZONE=Asia/Saigon
TRADE_SCANNER_WINDOWS=
TRADE_SCANNER_START_HOUR=0
TRADE_SCANNER_END_HOUR=24
TRADE_SCANNER_INTERVAL_MINUTES=5
TRADE_SCANNER_MIN_RISK_REWARD=2.0
TRADE_SCANNER_DEDUP_MINUTES=45

# === AUTO-BOT (trend-pullback, không scalp) ===
# false = chỉ gửi Telegram, bạn tự đặt lệnh. true = bot tự đặt MT5.
AUTO_TRADE=false
AUTO_TRADE_SCALP=false
AUTO_ALLOW_SCALP=false
AUTO_STRATEGY_MODE=xau_rftp
# Bật/tắt từng hướng. SELL đang tắt vì chưa qua walk-forward gần nhất.
AUTO_ALLOW_BUY=true
AUTO_ALLOW_SELL=false
AUTO_LOT_GOOD=0.01
AUTO_LOT_VERY_GOOD=0.01
AUTO_VERYGOOD_MIN_CONVICTION=2
AUTO_MAX_TRADES_PER_DAY=5
AUTO_MAX_DAILY_LOSS_PERCENT=2.5
AUTO_MAX_DAILY_LOSS_USD=2.5
AUTO_MAX_LOSS_USD_PER_TRADE=0.5
AUTO_MAX_HOLD_HOURS=8
AUTO_COOLDOWN_MINUTES=0
AUTO_COOLDOWN_M15_CANDLES=0
AUTO_AI_VETO=false
AUTO_USE_M15=true
AUTO_NEWS_BLACKOUT_ENABLED=true
AUTO_NEWS_BLACKOUT_MINUTES=30
AUTO_NEWS_BLACKOUT_BEFORE_MINUTES=20
AUTO_NEWS_BLACKOUT_AFTER_MINUTES=15
AUTO_NEWS_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
AUTO_NEWS_CALENDAR_CURRENCIES=USD,EUR
AUTO_NEWS_CALENDAR_IMPACTS=High
# SELL TP cố định (0 = dùng TP theo cấu trúc). Ví dụ: 4000 cho target về 4k.
AUTO_XAU_SELL_TP_TARGET=4000
MANUAL_SCALP=false
