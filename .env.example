EVOLINK_API_KEY=
EVOLINK_MODEL=claude-opus-4.8
EVOLINK_BASE_URL=https://api.evolink.ai/v1/chat/completions
AI_TIMEOUT_MS=90000
ACCOUNT_SIZE_USD=200
MAX_LOSS_PERCENT_PER_TRADE=15
MAX_DAILY_LOSS_PERCENT=15

MARKET_DATA_PROVIDER=mt5
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=https://api.twelvedata.com
MT5_BRIDGE_URL=http://127.0.0.1:8765
MT5_SYMBOL=XAUUSDm
MT5_EURUSD_SYMBOL=EURUSDm
MAX_QUOTE_AGE_SECONDS=180
MARKET_DATA_DEBUG=false

NEWS_PROVIDER=gnews
NEWS_API_KEY=
NEWS_BASE_URL=https://gnews.io
NEWS_MAX_AGE_HOURS=48

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TRADE_SCANNER_ENABLED=false
TRADE_SCANNER_TIMEZONE=Asia/Saigon
# Chi quet trong phien co thanh khoan (gio Viet Nam, mua he): chieu London 14-17h + toi NY/overlap 19-21h30.
# Mua dong (dau T11 -> giua T3) cac cua so lui muon ~1 tieng: 15:00-18:00,20:00-22:30.
TRADE_SCANNER_WINDOWS=14:00-17:00,19:00-21:30
TRADE_SCANNER_START_HOUR=19
TRADE_SCANNER_END_HOUR=23
TRADE_SCANNER_INTERVAL_MINUTES=15
TRADE_SCANNER_MIN_CONFIDENCE=75
TRADE_SCANNER_MIN_RISK_REWARD=1.5
TRADE_SCANNER_MIN_WIN_PROBABILITY=65
# Khong gui lai cung mot setup (cung huong/entry/SL) trong bay nhieu phut.
TRADE_SCANNER_DEDUP_MINUTES=45

# === Auto-bot (Rules Engine H1) ===
# true  = tu dat lenh tren MT5 theo method H1 da validate (tat scanner LLM).
# false = nhu hien tai: he thong bao tin hieu LLM, batch 15 phut.
AUTO_TRADE=false
# 2 muc lot: setup dep -> GOOD; setup rat dep (conviction >= AUTO_VERYGOOD_MIN_CONVICTION) -> VERY_GOOD.
AUTO_LOT_GOOD=0.03
AUTO_LOT_VERY_GOOD=0.05
AUTO_VERYGOOD_MIN_CONVICTION=2
AUTO_RR_TARGET=2.0
AUTO_MAX_TRADES_PER_DAY=5
AUTO_MAX_DAILY_LOSS_PERCENT=10
# Tu dong dong lenh neu giu qua bay nhieu gio ma chua cham SL/TP (khop backtest hold72).
AUTO_MAX_HOLD_HOURS=72
# AI recheck chi de VETO khi nang lot (khong bao gio de tu tin nang them). false = tat.
AUTO_AI_VETO=true
